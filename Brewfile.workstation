# Brewfile.workstation — extra packages for a GUI workstation, layered ON TOP of the
# base Brewfile. Installed only when this machine's profile is "workstation"
# (`./bootstrap.sh` / `./update.sh --type workstation`, remembered in dotfiles.lock; see update.sh).
# Server machines never install these.
#
# Same DSL as the base Brewfile: brew / cask / npm / cargo / tap / ...

cask "inkscape"
cask "tev"          # HDR/EXR image viewer (slow to install; Linux fixup in update.sh)
cask "obsidian"

# zathura — keyboard-driven PDF/PS/DjVu viewer (not in homebrew-core).
# macOS uses the upstream zathura tap; Linux uses our in-repo tap formulae.
tap "homebrew-zathura/zathura" if OS.mac?
brew "homebrew-zathura/zathura/zathura" if OS.mac?
brew "homebrew-zathura/zathura/zathura-pdf-mupdf" if OS.mac?
brew "doeringc/local/zathura" if OS.linux?
brew "doeringc/local/zathura-pdf-mupdf" if OS.linux?

# TeX Live (full) for LaTeX writeups built with pdflatex/latexmk (latex-writeup skill);
# conda-forge's texlive-core lacks the LaTeX packages.
brew "texlive"

cask "moonlight"

tap "LizardByte/homebrew"
brew "sunshine"

# add more workstation-only apps here, e.g.:
# cask "blender"
# cask "gimp"

cask "localsend"     # AirDrop alternative (Linux: x86_64 AppImage)
