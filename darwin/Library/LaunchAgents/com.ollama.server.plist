<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Autostart the (brew-installed) ollama server on macOS. Stowed to
  ~/Library/LaunchAgents by the darwin/ package; setup.sh bootstraps it into the
  GUI launchd domain. launchd starts agents with a minimal PATH, so the wrapper
  prepends Homebrew's bin (where `ollama` lives) before exec'ing `ollama serve`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ollama.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"; exec ollama serve &gt;&gt; "$HOME/Library/Logs/ollama.log" 2&gt;&amp;1</string>
    </array>

    <!-- Start at login and keep the server up (restart if it exits/crashes). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Background service priority (nice I/O + CPU scheduling). -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
