# per-machine choices (profile, …) written by update.sh via --type
dotfiles.lock

# nix leftovers
result

# macOS Finder junk
**/.DS_Store

# Claude-managed downloaded skill cache; local runtime state, not canonical skills
common/.agents/skills/synced/

# sunshine runtime state — on a fresh machine stow folds ~/.config/sunshine into
# the repo, so keep the credentials/state/log it writes there out of git
common/.config/sunshine/credentials/
common/.config/sunshine/sunshine_state.json
common/.config/sunshine/*.log

# gh writes its token here on machines without a keyring (~/.config/gh is stowed)
common/.config/gh/hosts.yml

# Python bytecode caches (skills run their scripts/tests in place)
common/.agents/**/__pycache__/
common/.agents/**/*.py[cod]
