#!/usr/bin/env bash
set -euo pipefail

OS="$(uname -s)"

usage() {
    echo "Usage: claudebox [OPTIONS] [PROJECT_DIR] [-- AGENT_ARGS...]"
    echo ""
    if [[ "$OS" == "Darwin" ]]; then
        echo "Run Claude Code or Codex without internal permissions inside a Seatbelt sandbox."
    else
        echo "Run Claude Code or Codex without internal permissions inside a Bubblewrap sandbox."
    fi
    echo ""
    echo "Arguments:"
    echo "  PROJECT_DIR          Project directory (default: current directory)"
    echo ""
    echo "Options:"
    echo "  --agent NAME         Agent to launch: claude (default) or codex"
    echo "  --bash               Launch a bash shell inside the sandbox"
    if [[ "$OS" != "Darwin" ]]; then
        echo "  --bind PATH          Bind extra directory read-write (repeatable)"
        echo "  --ro-bind PATH       Bind extra directory read-only (repeatable)"
        echo "  --share-pid          Share host PID namespace (shows all processes)"
    fi
    echo "  --ssh                Bind ~/.ssh read-only (off by default)"
    echo "  --block-env FILES    Comma-separated .env files to block (default: .env,.env.local,.env.production)"
    echo "  --no-block-env       Don't block any .env files"
    echo "  -h, --help           Show this help"
    echo ""
    echo "Anything after -- is passed directly to the selected agent."
    echo ""
    echo "Examples:"
    echo "  claudebox ~/projects/myapp"
    echo "  claudebox ~/projects/myapp -- 'Review the code'"
    echo "  claudebox --ssh ~/projects/myapp"
    echo "  claudebox --agent codex ~/projects/myapp"
    echo "  codexbox ~/projects/myapp  # shorthand for --agent codex"
    echo "  claudebox  # uses current directory"
}

BIND_SSH=false
SHARE_PID=false
AGENT=claude
BLOCK_ENV=".env,.env.local,.env.production"
PROJECT_DIR=""
SHELL_MODE=""
WRITE_PATHS=()
RO_PATHS=()
AGENT_ARGS=()

# Physical path (symlinks resolved). Every sandbox location is stored this way:
# the home is exposed read-only, so a symlink in it (e.g. ~/.cache -> /media/…)
# points at a target that isn't mounted, and bwrap can't mount over it ("Can't
# mkdir/bind mount …: No such file or directory"); Seatbelt also matches real paths.
physical() {
    if [[ ! -e "$1" ]]; then
        echo "Error: $1 does not exist" >&2
        exit 1
    fi
    realpath "$1"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --bash)
        SHELL_MODE=bash
        shift
        ;;
    --agent)
        AGENT="$2"
        shift 2
        ;;
    --share-pid)
        SHARE_PID=true
        shift
        ;;
    --bind)
        WRITE_PATHS+=("$(physical "$2")")
        shift 2
        ;;
    --ro-bind)
        RO_PATHS+=("$(physical "$2")")
        shift 2
        ;;
    --ssh)
        BIND_SSH=true
        shift
        ;;
    --block-env)
        BLOCK_ENV="$2"
        shift 2
        ;;
    --no-block-env)
        BLOCK_ENV=""
        shift
        ;;
    --)
        shift
        AGENT_ARGS+=("$@")
        break
        ;;
    *)
        if [[ -z "$PROJECT_DIR" && -d "$1" ]]; then
            PROJECT_DIR="$1"
        else
            # Forward unrecognized args to the selected agent
            AGENT_ARGS+=("$1")
        fi
        shift
        ;;
    esac
done

case "$AGENT" in
    claude | codex) ;;
    *)
        echo "Error: unsupported agent '$AGENT' (expected claude or codex)" >&2
        exit 2
        ;;
esac

PROJECT_DIR="$(physical "${PROJECT_DIR:-$(pwd)}")"

if [[ ! -d "$PROJECT_DIR" ]]; then
    echo "Error: $PROJECT_DIR is not a directory" >&2
    exit 1
fi

# Search upward from PROJECT_DIR for .claudebox config
find_config() {
    local dir="$1"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/.claudebox" ]]; then
            echo "$dir/.claudebox"
            return
        fi
        dir="$(dirname "$dir")"
    done
}

# Expand ~ and $HOME, resolve relative paths against the config file's directory
expand_path() {
    local p="$1" config_dir="$2"
    p="${p/#\~/$HOME}"
    p="${p/\$HOME/$HOME}"
    if [[ "$p" != /* ]]; then
        p="$config_dir/$p"
    fi
    echo "$p"
}

# Parse a claudebox config from stdin; relative paths resolve against $1.
# [mounts] applies to every agent, [mounts.<agent>] only to that agent; mounts
# whose path doesn't exist are skipped.
parse_config() {
    local config_dir="$1" current_section="" line key value local_path

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Strip comments and whitespace
        line="${line%%#*}"
        line="${line%%;;*}"
        line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [[ -z "$line" ]] && continue

        # Section header
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            current_section="${BASH_REMATCH[1]}"
            continue
        fi

        # Key = value pairs
        if [[ "$line" =~ ^([^=]+)=(.+)$ ]]; then
            key="$(echo "${BASH_REMATCH[1]}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            value="$(echo "${BASH_REMATCH[2]}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        else
            continue
        fi

        case "$current_section" in
            mounts | "mounts.$AGENT")
                local_path="$(expand_path "$value" "$config_dir")"
                [[ -e "$local_path" ]] || continue
                local_path="$(physical "$local_path")"
                case "$key" in
                    bind)    WRITE_PATHS+=("$local_path") ;;
                    ro-bind) RO_PATHS+=("$local_path") ;;
                esac
                ;;
            options)
                case "$key" in
                    ssh)       [[ "$value" == "true" ]] && BIND_SSH=true ;;
                    share-pid) [[ "$value" == "true" ]] && SHARE_PID=true ;;
                    block-env) BLOCK_ENV="$value" ;;
                esac
                ;;
        esac
    done
}

# Built-in defaults, used unless ~/.config/claudebox/config exists (which then
# replaces them entirely). Everything is readable; only these locations, the
# project dir, and the project's .claudebox / --bind extras are writable.
DEFAULT_CONFIG='
[mounts]
bind = ~/.cache

# The agent'"'"'s own state, so sessions and config persist.
[mounts.claude]
bind = ~/.claude
bind = ~/.claude.json

[mounts.codex]
bind = ~/.codex
'

# The writable locations are collected once, for both backends: the user (or
# built-in) config, then the project dir, then the project's .claudebox.
USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/claudebox/config"
if [[ -f "$USER_CONFIG" ]]; then
    parse_config "$(dirname "$USER_CONFIG")" <"$USER_CONFIG"
else
    parse_config "$HOME" <<<"$DEFAULT_CONFIG"
fi
WRITE_PATHS+=("$PROJECT_DIR")
CONFIG_FILE="$(find_config "$PROJECT_DIR")"
if [[ -n "$CONFIG_FILE" ]]; then
    parse_config "$(cd "$(dirname "$CONFIG_FILE")" && pwd)" <"$CONFIG_FILE"
fi

if [[ -n "$SHELL_MODE" ]]; then
    ENTRY_BIN="$(command -v "$SHELL_MODE" 2>/dev/null || true)"
    if [[ -z "$ENTRY_BIN" ]]; then
        echo "Error: $SHELL_MODE not found in PATH" >&2
        exit 1
    fi
    ENTRY_ARGS=()
else
    # Resolve the selected agent exactly as your shell does — whatever is first on PATH.
    # Install-mechanism-agnostic: works for a version-manager shim, a native
    # binary, a plain PATH entry — the script special-cases nothing.
    ENTRY_BIN="$(command -v "$AGENT" 2>/dev/null || true)"
    if [[ -z "$ENTRY_BIN" || ! -x "$ENTRY_BIN" ]]; then
        echo "Error: $AGENT not found in PATH" >&2
        exit 1
    fi
    if [[ "$AGENT" == "claude" ]]; then
        ENTRY_ARGS=(--dangerously-skip-permissions ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"})
    else
        ENTRY_ARGS=(--dangerously-bypass-approvals-and-sandbox ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"})
    fi
fi

# ── macOS: Seatbelt sandbox ──────────────────────────────────────────────────
if [[ "$OS" == "Darwin" ]]; then
    # Build the seatbelt profile dynamically
    PROFILE='(version 1)
(allow default)

;; Deny all file writes globally
(deny file-write*)

;; Allow writes needed for process spawning (pipes, PTYs, sockets)
(allow file-write* (vnode-type FIFO))
(allow file-write* (vnode-type CHARACTER-DEVICE))
(allow file-write* (vnode-type SOCKET))

;; Allow writes to temp directories
(allow file-write* (subpath "/private/tmp"))
(allow file-write* (subpath "/private/var/folders"))
(allow file-write* (subpath "/tmp"))
(allow file-write* (subpath "'"${TMPDIR:-/tmp}"'"))

;; Allow writes to nix store (for nix operations)
(allow file-write* (subpath "/nix"))

;; Allow writes to Keychain and security services (for OAuth token refresh)
(allow file-write* (subpath "'"$HOME/Library/Keychains"'"))
(allow file-write* (regex #"^/private/var/folders/.*/com\.apple\.security\."))
(allow file-write* (subpath "'"$HOME/Library/Preferences"'"))

;; Allow writes to Claude app data and cache (for token storage and refresh)
(allow file-write* (subpath "'"$HOME/Library/Application Support/Claude"'"))
(allow file-write* (subpath "'"$HOME/Library/Caches/claude-cli-nodejs"'"))
'

    # Writable locations (agent state, cache, project, extras). Reads are allowed
    # globally, so RO_PATHS need no rule.
    for write_path in "${WRITE_PATHS[@]}"; do
        PROFILE+='(allow file-write* (subpath "'"$write_path"'"))
'
    done

    # Block .env files
    if [[ -n "$BLOCK_ENV" ]]; then
        IFS=',' read -ra ENV_FILES <<<"$BLOCK_ENV"
        for env_file in "${ENV_FILES[@]}"; do
            env_path="$PROJECT_DIR/$env_file"
            if [[ -f "$env_path" ]]; then
                PROFILE+='(deny file-read* (literal "'"$env_path"'"))
'
            fi
        done
    fi

    cd "$PROJECT_DIR"
    exec sandbox-exec -p "$PROFILE" "$ENTRY_BIN" "${ENTRY_ARGS[@]}"
fi

# ── Linux: Bubblewrap sandbox ────────────────────────────────────────────────

# Build bwrap arguments — order matters: base mounts first, then overlays on top
BWRAP_ARGS=(
    # Sandbox essentials (must come first so later binds overlay correctly)
    --tmpfs /tmp
    --proc /proc
    --dev-bind /dev /dev
    --share-net
    --die-with-parent

    # System (read-only)
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --ro-bind /etc/hosts /etc/hosts
    --ro-bind /etc/ssl /etc/ssl
    --ro-bind /etc/passwd /etc/passwd
    --ro-bind /etc/group /etc/group
    --ro-bind /sys /sys
    --ro-bind /run /run
)

# PID namespace isolation (default: isolated, share-pid disables it)
if [[ "$SHARE_PID" != true ]]; then
    BWRAP_ARGS+=(--unshare-pid)
fi

# /lib and /lib64 may not exist on all systems
[[ -e /lib ]] && BWRAP_ARGS+=(--ro-bind /lib /lib)
[[ -e /lib64 ]] && BWRAP_ARGS+=(--ro-bind /lib64 /lib64)
[[ -e /sbin ]] && BWRAP_ARGS+=(--ro-bind /sbin /sbin)

# Nix store (read-only) - needed for nix-installed claude and tools
[[ -e /nix ]] && BWRAP_ARGS+=(--ro-bind /nix /nix)

# Expose the real home READ-ONLY. This makes claude — however it's installed
# (a version-manager shim, a native binary, a plain PATH entry, …) — resolve and
# run exactly as it does in your shell, WITHOUT this script knowing or naming any
# install mechanism. Writable bits (the project dir + claude's own state) are
# overlaid below; secrets are masked. Mirrors the macOS profile: reads allowed,
# only writes denied.
BWRAP_ARGS+=(--ro-bind "$HOME" "$HOME")

# Mask ~/.ssh by default with an empty tmpfs; --ssh re-exposes it (read-only, via
# the ro-bound home above — nothing extra needed).
if [[ "$BIND_SSH" != true ]] && [[ -d "$HOME/.ssh" ]]; then
    BWRAP_ARGS+=(--tmpfs "$HOME/.ssh")
fi

# Writable locations (agent state, cache, project, extras) overlaid on the
# read-only home, then extra read-only mounts.
for write_path in "${WRITE_PATHS[@]}"; do
    BWRAP_ARGS+=(--bind "$write_path" "$write_path")
done
for ro_path in "${RO_PATHS[@]+"${RO_PATHS[@]}"}"; do
    BWRAP_ARGS+=(--ro-bind "$ro_path" "$ro_path")
done
BWRAP_ARGS+=(--chdir "$PROJECT_DIR")

# Block .env files by overlaying with /dev/null
if [[ -n "$BLOCK_ENV" ]]; then
    IFS=',' read -ra ENV_FILES <<<"$BLOCK_ENV"
    for env_file in "${ENV_FILES[@]}"; do
        env_path="$PROJECT_DIR/$env_file"
        if [[ -f "$env_path" ]]; then
            BWRAP_ARGS+=(--ro-bind /dev/null "$env_path")
        fi
    done
fi

exec bwrap "${BWRAP_ARGS[@]}" "$ENTRY_BIN" "${ENTRY_ARGS[@]}"
