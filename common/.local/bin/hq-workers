#!/usr/bin/env bash
# hq-workers — bring HyperQueue workers up/down on remote hosts without a
# shared filesystem. Runs on the machine that hosts the hq server.
#
#   hq-workers up   [host...]   copy the current access file, (re)start a worker
#   hq-workers down [host...]   stop workers (via server if up, then pkill)
#   hq-workers status           list workers the server sees + remote processes
#
# Hosts: arguments > $HQ_HOSTS (space separated) > ~/.hq-server/hosts.txt.
# The remote side needs `hq` on its login-shell PATH (e.g. ~/.local/bin/hq)
# and passwordless ssh. Worker logs land in ~/.hq-server/worker.log remotely.
set -euo pipefail

server_dir="${HQ_SERVER_DIR:-$HOME/.hq-server}"
access="$server_dir/hq-current/access.json"

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

hosts() {
	if [ "$#" -gt 0 ]; then printf '%s\n' "$@"
	elif [ -n "${HQ_HOSTS:-}" ]; then printf '%s\n' $HQ_HOSTS
	elif [ -r "$server_dir/hosts.txt" ]; then grep -v '^[[:space:]]*\(#\|$\)' "$server_dir/hosts.txt"
	else echo "hq-workers: no hosts (pass them, set HQ_HOSTS, or write $server_dir/hosts.txt)" >&2; exit 1
	fi
}

server_up() { hq --server-dir "$server_dir" --output-mode quiet server info >/dev/null 2>&1; }

# Remote commands run through a login shell so ~/.local/bin / brew are on PATH.
remote() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$1" "bash -lc $(printf '%q' "$2")"; }

up() {
	if ! server_up; then
		echo "hq-workers: no hq server running at $server_dir — start it first (hq server start)" >&2
		exit 1
	fi
	for h in $(hosts "$@"); do
		echo "==> $h"
		remote "$h" 'mkdir -p ~/.hq-server/hq-current && command -v hq >/dev/null || { echo "hq not on PATH"; exit 1; }'
		scp -q "$access" "$h:.hq-server/hq-current/access.json"
		# a worker from a previous server holds a stale access file: replace it
		remote "$h" 'pkill -u "$USER" -f "hq worker start" && sleep 1 || true
			nohup hq worker start >~/.hq-server/worker.log 2>&1 </dev/null &
			disown'
	done
	sleep 2
	hq --server-dir "$server_dir" worker list
}

down() {
	if server_up; then hq --server-dir "$server_dir" worker stop all >/dev/null 2>&1 || true; fi
	for h in $(hosts "$@"); do
		echo "==> $h"
		remote "$h" 'pkill -u "$USER" -f "hq worker start" && echo "stopped" || echo "no worker running"'
	done
}

status() {
	if server_up; then hq --server-dir "$server_dir" worker list; else echo "server: not running"; fi
	for h in $(hosts "$@"); do
		printf '%-10s ' "$h"
		remote "$h" 'pgrep -u "$USER" -f "hq worker start" >/dev/null && echo "worker process running" || echo "no worker process"' \
			|| echo "unreachable"
	done
}

case "${1:-}" in
	up|down|status) cmd=$1; shift; "$cmd" "$@" ;;
	-h|--help|help) usage ;;
	*) usage 1 >&2 ;;
esac
