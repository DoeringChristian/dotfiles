# --- AI CLIs (all brew) ---
# claude: brew cask (installs the `claude` CLI). Its own auto-updater is disabled
# (~/.claude/settings.json autoUpdates:false) so brew is the SOLE owner and there's
# no version drift; bump it with `brew upgrade --cask`. On Linux (no casks) the
# installer runs (pkg/install.sh install_app_linux). Trails latest by a few patches.
claude            cask    cask=claude-code
gemini-cli        pkg                                          # brew (trails npm ~6 minor; accepted for uniformity)
# claude-agent-acp dropped: only consumer was agentic.nvim (enabled=false). If you
# re-enable it, add:  claude-agent-acp  npm  pkg=@zed-industries/claude-code-acp

# --- GUI apps (cask on macOS / official build on Linux) ---
kitty             cask    github=kovidgoyal/kitty
tev               cask    github=Tom94/tev

# --- custom brew formulae (local tap, pkg/Formula/*.rb; built from source) ---
sshr              formula   # brew install --HEAD (git main)
passage           formula
